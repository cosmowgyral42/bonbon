# Optional — you can also paste these in the app's Settings page instead.
ANTHROPIC_API_KEY=
BUFFER_API_KEY=

# Public GitHub repo for post images (used when catbox.moe is unavailable)
BONBON_GITHUB_MEDIA_REPO=

# ── Hosting Bonbon as a public site (leave unset for a local install) ──
# Each browser gets its own private workspace; API keys are encrypted at rest and
# the keys above are never used.
# BONBON_HOSTED=1
# BONBON_SECRET=          # 32+ random characters, e.g. `openssl rand -hex 32`. Changing it makes saved keys unreadable.
# BONBON_STORAGE=files    # default on a hosted site is Netlify Blobs; "files" keeps workspaces in data/workspaces
# BONBON_PUBLIC_URL=      # optional: site URL used for image links sent to Buffer
